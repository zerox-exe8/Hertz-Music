# ==========================================
# Hertz Music Bot - Environment Configuration
# ==========================================

# Discord Bot Token (From Discord Developer Portal)
DISCORD_TOKEN=

# Bot Branding & Identity
BOT_NAME=Hertz Music
BOT_DESCRIPTION=Ultra-High-Fidelity 320kbps Lossless Audio Music Engine
DEFAULT_PREFIX=.
EMBED_COLOR=0x2B2D31
FOOTER_TEXT=Hertz Music | 320kbps CD Master Quality

# Presence & Status
STATUS_TEXT=.help | 320kbps HD Audio
ACTIVITY_TYPE=listening
STATUS_STATE=online

# Support & Links
SUPPORT_SERVER_URL=https://discord.gg/
BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&permissions=8&scope=bot%20applications.commands

# Developer & Owner IDs (Comma separated if multiple)
DEVELOPER_IDS=

# 24/7 Web Server Port (For Render / UptimeRobot)
PORT=8080
